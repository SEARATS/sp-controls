<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.2.1</Version>
    <Title>Controls &amp; Settings</Title>
    <Description>Native Sea Power UI controls and shared mod settings pages.</Description>
    <PluginDeployDirectory>$(SeaPowerDir)/Sea Power_Data/StreamingAssets/ControlsAndSettings</PluginDeployDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Seapower-Scripts" HintPath="$(GameManaged)\Seapower-Scripts.dll" Private="false" />
    <Reference Include="Noesis.NoesisGUI" HintPath="$(GameManaged)\Noesis.NoesisGUI.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameManaged)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UniRx" HintPath="$(GameManaged)\UniRx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(SeaPowerDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="AnchorChain" HintPath="$(AnchorChainDll)" Private="false" />
  </ItemGroup>
  <Import Project="../SeaPower.SharedUi/SeaPower.SharedUi.props" />
  <Import Project="../SeaPower.SharedSettings/SeaPower.SharedSettings.props" />
  <Target Name="StageWorkshopPackage" AfterTargets="Build">
    <PropertyGroup>
      <WorkshopPackageDirectory>$(MSBuildProjectDirectory)/../../artifacts/workshop/ControlsAndSettings</WorkshopPackageDirectory>
      <WorkshopPreviewDirectory>$(MSBuildProjectDirectory)/../../artifacts/workshop/ControlsAndSettings-previews</WorkshopPreviewDirectory>
    </PropertyGroup>
    <ItemGroup>
      <WorkshopPreview Include="$(MSBuildProjectDirectory)/../../artifacts/mod-icons/controls-gallery/*-page.png;$(MSBuildProjectDirectory)/../../artifacts/mod-icons/settings-pages/*.png" />
    </ItemGroup>
    <MakeDir Directories="$(WorkshopPackageDirectory)" />
    <Copy SourceFiles="$(TargetPath);$(MSBuildProjectDirectory)/README.md;$(MSBuildProjectDirectory)/../../content/workshop/controls/_info.ini" DestinationFolder="$(WorkshopPackageDirectory)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../../docs/controls-settings/changelog.md" DestinationFiles="$(WorkshopPackageDirectory)/CHANGELOG.md" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../../artifacts/mod-icons/controls.jpg" DestinationFiles="$(WorkshopPackageDirectory)/thumbnail.jpg" Condition="Exists('$(MSBuildProjectDirectory)/../../artifacts/mod-icons/controls.jpg')" />
    <MakeDir Directories="$(WorkshopPreviewDirectory)" />
    <Copy SourceFiles="@(WorkshopPreview)" DestinationFolder="$(WorkshopPreviewDirectory)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="DeployToSeaPower" AfterTargets="StageWorkshopPackage" Condition="'$(OS)' == 'Windows_NT' and '$(DeployToGame)' == 'true'">
    <MakeDir Directories="$(PluginDeployDirectory)" />
    <Copy SourceFiles="$(TargetPath);$(MSBuildProjectDirectory)/README.md;$(MSBuildProjectDirectory)/../../content/workshop/controls/_info.ini" DestinationFolder="$(PluginDeployDirectory)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../../docs/controls-settings/changelog.md" DestinationFiles="$(PluginDeployDirectory)/CHANGELOG.md" />
  </Target>
</Project>
