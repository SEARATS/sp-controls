<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.2.0</Version>
    <PackageId>SP.Controls.UI</PackageId>
    <Authors>agm-114</Authors>
    <Description>Source package for native Sea Power mod controls and layouts.</Description>
    <RepositoryUrl>https://github.com/SEARATS/sp-controls</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <None Include="*.cs" Pack="true" PackagePath="buildTransitive/" />
    <None Update="UI.props" Pack="true" PackagePath="buildTransitive/SP.Controls.UI.props" />
    <None Update="_._" Pack="true" PackagePath="lib/$(TargetFramework)/" />
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
